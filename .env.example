PORT=5000
DB_URL=your_database_url_string
NODE_ENV=development

# BCRYPT
BCRYPT_SALT_ROUND=bcrypt_round_number

# JWT
JWT_ACCESS_SECRET=jwt_secret_token
JWT_ACCESS_EXPIRES=token_expiresIn
JWT_REFRESH_SECRET=jwt_refresh_token
JWT_REFRESH_EXPIRES=refresh_expiresIn

# SUPER ADMIN
SUPER_ADMIN_EMAIL=super@gmail.com
SUPER_ADMIN_PASSWORD=Super@123456

# GOOGLE
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# EXPRESS SESSION
EXPRESS_SESSION_SECRET=express_session_secret

# FRONT-END URL
FRONTEND_URL=http://localhost:5173

# SSLCOMMERZ
SSL_STORE_ID=store-id
SSL_STORE_PASS=store-password
SSL_PAYMENT_API=payment-api
SSL_VALIDATION_API=validation-api